section Assembly
variable (cert : ∀ p ∈ denied, optimized 8 p.1 p.2 = false)
include cert
theorem place (e : ℕ) (l : List W) : optimized 8 e l = true → !denied.contains (e,l) = true := by
  intro h; by_contra! hn
  have hm : (e,l) ∈ denied := by simpa using hn
  have := cert (e,l) hm
  simp_all
theorem whole : optimized 9 1 inputs = false := by
  apply Bool.eq_false_iff.mpr
  intro h
  change (inputs == [goal] || (pairs inputs).any _) = true at h
  have h0 : (inputs == [goal]) = false := by decide
  simp only [h0, Bool.false_or, List.any_eq_true] at h
  obtain ⟨⟨a,b,r⟩, hm, hh⟩ := h
  have exhausted : (pairs inputs).all (fun (a,b,r) => !(dispatch 1 (fun e l => !denied.contains (e,l)) a b r)) = true := by decide +kernel
  have hn := List.all_eq_true.mp exhausted (a,b,r) hm
  change (!dispatch 1 _ a b r) = true at hn
  simp only [dispatch, List.any_eq_true, Bool.or_eq_true, Bool.and_eq_true] at hh
  have go : dispatch 1 (fun e l => !denied.contains (e,l)) a b r = true := by
    simp only [dispatch, List.any_eq_true, Bool.or_eq_true, Bool.and_eq_true]
    obtain ⟨w, hw, h⟩ := hh
    exact ⟨w, hw, by rcases h with ((⟨x,y⟩ | ⟨x, (⟨a1,b1⟩ | ⟨a2,b2⟩)⟩) | ⟨⟨x,y⟩,z⟩)
                     · exact Or.inl (Or.inl ⟨x, place cert _ _ y⟩)
                     · exact Or.inl (Or.inr ⟨x, Or.inl ⟨a1, place cert _ _ b1⟩⟩)
                     · exact Or.inl (Or.inr ⟨x, Or.inr ⟨a2, place cert _ _ b2⟩⟩)
                     · exact Or.inr ⟨⟨x,y⟩, place cert _ _ z⟩⟩
  simp_all
theorem front : inputs.sublists.all (fun l => (cuts l != -1) || !(optimized 9 (10-l.length) l)) = true := by
  have h : inputs.sublists.all (fun l => (cuts l != -1) || (l == inputs)) = true := by decide +kernel
  apply List.all_eq_true.mpr
  intro l hl
  have q := List.all_eq_true.mp h l hl
  simp only [Bool.or_eq_true, beq_iff_eq] at q
  rcases q with q | rfl
  · simp only [Bool.or_eq_true]
    exact Or.inl q
  · change (_ || !(optimized 9 1 inputs)) = true
    simp [whole cert]
theorem no_small (C : Circuit) (hm : Monotone2 C) (hs : C.size ≤ 9)
    (hr : PEqualNP.Represents.Represents A C) : False := by
  obtain ⟨S, hsub, hl⟩ := compress (get_build C hm hr)
  have hl3 : live basicOps goal 9 S := extend_live hs hl
  let l := inputs.filter (fun w => decide (w ∈ S))
  have hlS : l.toFinset = S := by
    ext v
    simp only [l, List.mem_toFinset, List.mem_filter, decide_eq_true_eq]
    constructor
    · exact fun h => h.2
    · exact fun h => ⟨List.mem_toFinset.mp (hsub h), h⟩
  have hnd : l.Nodup := inputs_nodup.filter _
  have hcard := live_card hl3
  rw [← hlS, List.toFinset_card_of_nodup hnd] at hcard
  have hsearch := optimized_complete 9 l (10 - l.length) hnd (by omega) (hlS ▸ hl3)
  have hmem : l ∈ inputs.sublists := List.mem_sublists.mpr List.filter_sublist
  have hc := cuts_full (hlS ▸ hl3 : live basicOps goal 9 l.toFinset)
  have hall := List.all_eq_true.mp (front cert) l hmem
  simpa [hc, hsearch] using hall
end Assembly
end PEqualNP.Outside.Mask106301
