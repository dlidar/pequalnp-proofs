open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity
theorem allRejected (checked0 : group0.all reject = true) (checked1 : group1.all reject = true) (checked2 : group2.all reject = true) (checked3 : group3.all reject = true) (checked4 : group4.all reject = true) (checked5 : group5.all reject = true) (checked6 : group6.all reject = true) (checked7 : group7.all reject = true) (checked8 : group8.all reject = true) (checked9 : group9.all reject = true) (checked10 : group10.all reject = true) (checked11 : group11.all reject = true) (checked12 : group12.all reject = true) (checked13 : group13.all reject = true) (checked14 : group14.all reject = true) (checked15 : group15.all reject = true) (checked16 : group16.all reject = true) (checked17 : group17.all reject = true) (checked18 : group18.all reject = true) (checked19 : group19.all reject = true) (checked20 : group20.all reject = true) (checked21 : group21.all reject = true) (checked22 : group22.all reject = true) (checked23 : group23.all reject = true) (checked24 : group24.all reject = true) (checked25 : group25.all reject = true) (checked26 : group26.all reject = true) (checked27 : group27.all reject = true) (checked28 : group28.all reject = true) (checked29 : group29.all reject = true) (checked30 : group30.all reject = true) : allRoots.all reject = true := by
  simp only [allRoots, List.all_append, checked0, checked1, checked2, checked3, checked4, checked5, checked6, checked7, checked8, checked9, checked10, checked11, checked12, checked13, checked14, checked15, checked16, checked17, checked18, checked19, checked20, checked21, checked22, checked23, checked24, checked25, checked26, checked27, checked28, checked29, checked30, Bool.and_self]
theorem front (checked0 : group0.all reject = true) (checked1 : group1.all reject = true) (checked2 : group2.all reject = true) (checked3 : group3.all reject = true) (checked4 : group4.all reject = true) (checked5 : group5.all reject = true) (checked6 : group6.all reject = true) (checked7 : group7.all reject = true) (checked8 : group8.all reject = true) (checked9 : group9.all reject = true) (checked10 : group10.all reject = true) (checked11 : group11.all reject = true) (checked12 : group12.all reject = true) (checked13 : group13.all reject = true) (checked14 : group14.all reject = true) (checked15 : group15.all reject = true) (checked16 : group16.all reject = true) (checked17 : group17.all reject = true) (checked18 : group18.all reject = true) (checked19 : group19.all reject = true) (checked20 : group20.all reject = true) (checked21 : group21.all reject = true) (checked22 : group22.all reject = true) (checked23 : group23.all reject = true) (checked24 : group24.all reject = true) (checked25 : group25.all reject = true) (checked26 : group26.all reject = true) (checked27 : group27.all reject = true) (checked28 : group28.all reject = true) (checked29 : group29.all reject = true) (checked30 : group30.all reject = true) : ∀ t : Fin 11, rawInputs.sublists.all (fun ws =>
    decide (10 < ws.length + t.val) || (cuts (decide (0 < t.val)) ws != top) || !(search 9 t.val ws)) = true := by
  intro t
  apply List.all_eq_true.mpr
  intro ws hw
  have hc := List.all_eq_true.mp (coverage t) ws hw
  cases h : (decide (10 < ws.length + t.val) || (cuts (decide (0 < t.val)) ws != top)) with
  | true => simp [h]
  | false =>
    simp only [h, Bool.false_or] at hc ⊢
    have hm : (t.val, ws) ∈ allRoots := by simpa using hc
    exact List.all_eq_true.mp (allRejected checked0 checked1 checked2 checked3 checked4 checked5 checked6 checked7 checked8 checked9 checked10 checked11 checked12 checked13 checked14 checked15 checked16 checked17 checked18 checked19 checked20 checked21 checked22 checked23 checked24 checked25 checked26 checked27 checked28 checked29 checked30) (t.val, ws) hm

theorem lower (checked0 : group0.all reject = true) (checked1 : group1.all reject = true) (checked2 : group2.all reject = true) (checked3 : group3.all reject = true) (checked4 : group4.all reject = true) (checked5 : group5.all reject = true) (checked6 : group6.all reject = true) (checked7 : group7.all reject = true) (checked8 : group8.all reject = true) (checked9 : group9.all reject = true) (checked10 : group10.all reject = true) (checked11 : group11.all reject = true) (checked12 : group12.all reject = true) (checked13 : group13.all reject = true) (checked14 : group14.all reject = true) (checked15 : group15.all reject = true) (checked16 : group16.all reject = true) (checked17 : group17.all reject = true) (checked18 : group18.all reject = true) (checked19 : group19.all reject = true) (checked20 : group20.all reject = true) (checked21 : group21.all reject = true) (checked22 : group22.all reject = true) (checked23 : group23.all reject = true) (checked24 : group24.all reject = true) (checked25 : group25.all reject = true) (checked26 : group26.all reject = true) (checked27 : group27.all reject = true) (checked28 : group28.all reject = true) (checked29 : group29.all reject = true) (checked30 : group30.all reject = true) (C : Circuit) (hg : FanInTwo C) (hs : C.size ≤ 9) (he : Correct C) : False := by
  obtain ⟨t,S,hsub,hl⟩ := compress (get_build C hg he)
  let l := rawInputs.filter (fun a => decide (a ∈ S))
  have eq : l.toFinset = S := by
    ext a
    simp only [l,List.mem_toFinset,List.mem_filter,decide_eq_true_eq]
    exact ⟨fun h => h.2,fun h => ⟨List.mem_toFinset.mp (hsub h),h⟩⟩
  have nd : l.Nodup := (by decide : rawInputs.Nodup).filter _
  have hv : ∀ a ∈ l, valid a := fun a ha => rawInputs_valid a (List.mem_filter.mp ha).1
  have hl5 := extend hs hl
  have lin : live 9 t l.toFinset := eq ▸ hl5
  have hc := live_card lin
  rw [List.toFinset_card_of_nodup nd] at hc
  have hsep := cuts_full hv lin
  have hit := search_complete 9 t l nd hv lin
  have row := List.all_eq_true.mp (front checked0 checked1 checked2 checked3 checked4 checked5 checked6 checked7 checked8 checked9 checked10 checked11 checked12 checked13 checked14 checked15 checked16 checked17 checked18 checked19 checked20 checked21 checked22 checked23 checked24 checked25 checked26 checked27 checked28 checked29 checked30 ⟨t,by omega⟩) l (List.mem_sublists.mpr List.filter_sublist)
  simp [show ¬10 < l.length + t by omega,hsep,hit] at row
end PEqualNP.Outside.Mask5805
