theorem target_spec (x : EdgeInput → Bool) :
    target x = true ↔ ∃ r, x (left r) = true ∧ x (right r) = true := by simp [target]

theorem edgeTransport : ∀ (g : Sym) (r : Row), let t := edgePerm g r
    (perm g (left r) = left t ∧ perm g (right r) = right t) ∨
    (perm g (left r) = right t ∧ perm g (right r) = left t) := by decide +kernel

theorem edgeInverse : ∀ (g : Sym) (r : Row), edgePerm g (edgeInv g r) = r := by decide +kernel
theorem inputInverse : ∀ (g : Sym) (i : EdgeInput), perm g (inv g i) = i ∧ inv g (perm g i) = i := by decide +kernel

theorem sameTarget (g : Sym) (x : EdgeInput → Bool) : target (x ∘ perm g) = target x := by
  apply Bool.eq_iff_iff.mpr
  rw [target_spec,target_spec]
  constructor
  · rintro ⟨r,h1,h2⟩
    refine ⟨edgePerm g r,?_⟩
    rcases edgeTransport g r with ⟨a,b⟩ | ⟨a,b⟩ <;> simp_all [Function.comp_def]
  · rintro ⟨r,h1,h2⟩
    refine ⟨edgeInv g r,?_⟩
    rcases edgeTransport g (edgeInv g r) with ⟨a,b⟩ | ⟨a,b⟩ <;> simp_all [Function.comp_def,edgeInverse]

def arg1 (k : Key) := (pairTab[k.val % 91]!).1
def arg2 (k : Key) := (pairTab[k.val % 91]!).2
theorem cacheTransport : ∀ k : Key, let g := sym k; let j := reprKey k
    ((k.val < 91) ↔ (j.val < 91)) ∧
    ((perm g (arg1 k) = arg1 j ∧ perm g (arg2 k) = arg2 j) ∨
     (perm g (arg1 k) = arg2 j ∧ perm g (arg2 k) = arg1 j)) := by decide +kernel

def rename {I J : Type} (g : I → J) : Formula I → Formula J
  | .var i => .var (g i)
  | .conj a b => .conj (rename g a) (rename g b)
  | .disj a b => .disj (rename g a) (rename g b)

theorem renameEval {I J} (g : I → J) (f : Formula I) (x : J → Bool) :
    (rename g f).eval x = f.eval (x ∘ g) := by induction f <;> simp_all [rename,Formula.eval,Function.comp_def]

theorem renameLeaves {I J} (g : I → J) (f : Formula I) :
    (rename g f).leaves = f.leaves := by induction f <;> simp_all [rename,Formula.leaves]

theorem signalMap (k : Key) (x : EdgeInput → Bool) :
    (extendsKey (reprKey k) x) ∘ (Option.map (perm (sym k))) =
        extendsKey k (x ∘ perm (sym k)) := by
  funext i
  cases i with
  | some a => rfl
  | none =>
    obtain ⟨op,ha⟩ := cacheTransport k
    change (if decide ((reprKey k).val<91) then x (arg1 _) && x (arg2 _) else x (arg1 _) || x (arg2 _)) =
        (if decide (k.val<91) then x (perm _ (arg1 _)) && x (perm _ (arg2 _)) else x (perm _ (arg1 _)) || x (perm _ (arg2 _)))
    rcases ha with ⟨a,b⟩ | ⟨a,b⟩ <;> simp [op,a,b,Bool.and_comm,Bool.or_comm]

theorem boundTransport (k : Key) (b : ℕ) (h : Bound b (reprKey k)) : Bound b k := by
  intro f hf
  have hb := h (rename (Option.map (perm (sym k))) f) (fun x => by
    rw [renameEval,signalMap,hf,sameTarget])
  simpa only [renameLeaves] using hb
end PEqualNP.Research.Cached18330
