import Upper
namespace PEqualNP.Research.Cached9815
open TripleFormulaMass Finset
def invFill (i : EdgeInput) (x : EdgeInput → Bool) : Option EdgeInput → Bool
  | some j => x j
  | none => !(x i)
def positiveMass (wt : Weights) (i : EdgeInput) :=
  ∑ c∈univ.filter (fun c => neg c i=true),∑ r∈univ.filter (fun r => pos r i=false),max 0 (wt r c)
theorem inv_atom (wt : Weights) (i : EdgeInput) (rs : Finset Row) (cs : Finset Col)
    (hp : ∀ r∈rs,invFill i (pos r) none=true) (hq : ∀ c∈cs,invFill i (neg c) none=false) :
    mass wt rs cs ≤ positiveMass wt i := by
  have rsub : rs ⊆ univ.filter (fun r => pos r i=false) := by
    intro r hr
    exact mem_filter.mpr ⟨mem_univ _,by simpa [invFill] using hp r hr⟩
  have csub : cs ⊆ univ.filter (fun c => neg c i=true) := by
    intro c hc
    exact mem_filter.mpr ⟨mem_univ _,by simpa [invFill] using hq c hc⟩
  unfold mass positiveMass
  calc
    _ ≤ ∑ c∈cs,∑ r∈rs,max 0 (wt r c) := sum_le_sum fun c _ => sum_le_sum fun r _ => le_max_right _ _
    _ ≤ ∑ c∈cs,∑ r∈univ.filter (fun r => pos r i=false),max 0 (wt r c) :=
      sum_le_sum fun c _ => sum_le_sum_of_subset_of_nonneg rsub fun _ _ _ => le_max_left _ _
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg csub fun c _ _ => sum_nonneg fun _ _ => le_max_left _ _
def InvBound (i : EdgeInput) := ∀ f : Formula (Option EdgeInput),
  (∀ x,f.eval (invFill i x)=target x) → 26≤f.leaves
theorem by_inv_cert (wt : Weights) (cap : Int) (i : EdgeInput) (hc : 0<cap)
    (raw : rawOK wt cap=true) (extra : positiveMass wt i≤cap)
    (total : 25*cap < mass wt univ univ) : InvBound i := by
  intro f correct
  have atRaw := atom_from_columns pos neg wt cap (by
    intro j s hs
    have ok := List.all_eq_true.mp raw j (by simp)
    exact score_ok _ _ _ _ (by simpa using ok) _ hs)
  have atom : ∀ j (rs : Finset Row) (cs : Finset Col), (∀ r∈rs,invFill i (pos r) j=true) →
      (∀ c∈cs,invFill i (neg c) j=false) → mass wt rs cs≤cap := by
    intro j rs cs a b
    cases j with
    | none => exact (inv_atom wt i rs cs a b).trans extra
    | some j => exact atRaw j rs cs a b
  have h := weight_bound _ _ wt cap atom f univ univ
    (fun r _ => (correct _).trans (rows_ok r)) (fun c _ => (correct _).trans (cols_ok c))
  by_contra! low
  have le : (f.leaves : Int) ≤ 25 := by omega
  linarith [mul_le_mul_of_nonneg_left le (le_of_lt hc)]
