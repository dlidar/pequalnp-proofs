def errorColumn : BitVec 32768 := 

theorem packed_candidate :
    (candidate.gates.foldl hcsStep rawInputs).getD candidate.output 0 = packed ||| errorColumn := by
  decide +kernel

theorem false_only : errorColumn &&& packed = 0 := by decide +kernel

theorem value (x : Fin 15 → Bool) : candidate.eval (List.ofFn x) =
    (posted x || errorColumn.getLsbD (hcsBitsNat x)) := by
  let i : Fin 32768 := ⟨hcsBitsNat x,hcsBitsNat_lt x⟩
  have bank := rawInputs_map x
  have fold := hcsFoldBits rawInputs i candidate.gates basis_ok
  have raw (j : Fin 15) : (rawInputs.getD j.val 0).getLsbD i.val = x j := by
    rw [hcsGetDBit,bank]
    simp only [List.getD_eq_getElem?_getD,List.getElem?_ofFn,j.isLt,dite_true,Option.getD_some]
  have bits := bvTarget_bit (fun j : Fin 15 => rawInputs.getD j.val 0) i
  rw [← evalBvTarget_eq,← packed_eq,funext raw,← posted_eq] at bits
  change (candidate.gates.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun k => w.getD k false)])
    (List.ofFn x)).getD candidate.output false = _
  rw [← bank,← fold,← hcsGetDBit,packed_candidate,BitVec.getLsbD_or,bits]

theorem no_false_negatives (x : Fin 15 → Bool) (h : posted x = true) :
    candidate.eval (List.ofFn x) = true := by rw [value,h]; rfl

-- A finite list of surviving false positives, indexed by the fifteen edge bits.
def singletonBit (i : Nat) : BitVec 32768 := (1 : BitVec 32768) <<< i

theorem bit_list : errorList.foldr (fun i m => singletonBit i ||| m) 0 = errorColumn := by decide +kernel

theorem in_range : ∀ i ∈ errors, i < 32768 := by decide +kernel

theorem unit_at (v i : Nat) (hi : i < 32768) :
    (singletonBit v).getLsbD i = decide (v = i) := by
  simp only [singletonBit, BitVec.getLsbD_shiftLeft, hi, decide_true, Bool.true_and,
    BitVec.getLsbD_one, show 0 < 32768 by decide]
  by_cases hv : v = i
  · subst v; simp
  · rcases lt_or_gt_of_ne hv with less | greater
    · simp [show ¬ i < v by omega,show i-v ≠ 0 by omega,hv]
    · simp [greater,hv]

theorem fold_at (s : List Nat) (i : Nat) (hi : i < 32768) :
    (s.foldr (fun v m => singletonBit v ||| m) (0 : BitVec 32768)).getLsbD i = decide (i ∈ s) := by
  induction s with
  | nil => simp
  | cons v t ih =>
    simp only [List.foldr_cons,BitVec.getLsbD_or,unit_at v i hi,ih,List.mem_cons,Bool.decide_or]
    simp [eq_comm]

theorem precisely (i : Nat) (hi : i < 32768) : errorColumn.getLsbD i = decide (i ∈ errors) := by
  rw [← bit_list,fold_at _ _ hi]
  simp [errors]

set_option maxRecDepth 100000 in
theorem error_iff (x : Fin 15 → Bool) :
    candidate.eval (List.ofFn x) ≠ posted x ↔ hcsBitsNat x ∈ errors := by
  let i : Fin 32768 := ⟨_,hcsBitsNat_lt x⟩
  have raw (j : Fin 15) : (rawInputs.getD j.val 0).getLsbD i.val = x j := by
    rw [hcsGetDBit,rawInputs_map x]
    simp only [List.getD_eq_getElem?_getD,List.getElem?_ofFn,j.isLt,dite_true,Option.getD_some]
  have bits := bvTarget_bit (fun j : Fin 15 => rawInputs.getD j.val 0) i
  rw [← evalBvTarget_eq,← packed_eq,funext raw,← posted_eq] at bits
  have dis := congrArg (fun b : BitVec 32768 => b.getLsbD i.val) false_only
  have hz : (0 : BitVec 32768).getLsbD i.val = false := by
    exact BitVec.getLsbD_zero
  simp only [BitVec.getLsbD_and,bits,hz] at dis
  rw [value,precisely _ (hcsBitsNat_lt x)]
  change (errorColumn.getLsbD (hcsBitsNat x) && posted x) = false at dis
  rw [precisely _ (hcsBitsNat_lt x)] at dis
  by_cases he : hcsBitsNat x ∈ errors <;> simp_all

