def edge (p l : Fin 13) : ℕ := 2^p.val ||| 2^(13+l.val)
def inc (p l : Fin 13) : Prop := p-l ∈ ({0,1,3,9} : Finset (Fin 13))
instance (p l : Fin 13) : Decidable (inc p l) := by unfold inc; infer_instance
def points (q : ℕ) := Finset.univ.filter (fun p : Fin 13 => q.testBit p.val)
def quad (Q : Finset (Fin 13)) := Q.card = 4 ∧ ∀ l : Fin 13, (Q.filter (fun p => inc p l)).card ≤ 2
instance (Q : Finset (Fin 13)) : Decidable (quad Q) := by unfold quad; infer_instance
def sub (u v : ℕ) : Bool := u &&& v == u
def extend (d : Fin 26) (z : ℕ) := z ||| 2^d.val
def project (d : Fin 26) (z : ℕ) : Bool := (List.finRange 51).any (fun i => sub (pos i) (extend d z))

