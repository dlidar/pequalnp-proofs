theorem almost_bound : HasCircuitSize 40 edited 113 :=
  ⟨almost, almost_fan, Nat.le_of_eq almost_size, almost_eval⟩
theorem restore_edge (x : Fin 40 → Bool) : target x = (x 2 && x 21 || edited x) := by
  cases h : (x 2 && x 21) <;> simp [target, edited, h, Bool.or_assoc]
theorem exact_misses (x : Fin 40 → Bool) :
    (target x ≠ almost.eval (List.ofFn x)) ↔ x 2 = true ∧ x 21 = true ∧ edited x = false := by
  rw [almost_eval, restore_edge]
  cases x 2 <;> cases x 21 <;> cases edited x <;> decide
theorem no_false_positives (x : Fin 40 → Bool) (h : almost.eval (List.ofFn x) = true) :
    target x = true := by
