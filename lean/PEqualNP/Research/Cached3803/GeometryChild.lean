abbrev bits := Finset (Fin 13)
private theorem readP (X Y : bits) (p : Fin 13) :
    (incidenceInput X Y).getD p.val false = decide (p ∈ X) := by
  fin_cases p <;> simp [incidenceInput]
private theorem readL (X Y : bits) (l : Fin 13) :
    (incidenceInput X Y).getD (13+l.val) false = decide (l ∈ Y) := by
  fin_cases l <;> simp [incidenceInput]
private theorem readFar (X Y : bits) (i : ℕ) (h : 26 ≤ i) :
    (incidenceInput X Y).getD i false = false := by
  apply List.getD_eq_default
  simpa [incidenceInput] using h
theorem agree_rows (b : Bool) (A B D E T U : bits)
    (hp : ∀ p, decide (p ∈ A) = b → decide (p ∈ D) = b → decide (p ∈ T) = b)
    (hl : ∀ l, decide (l ∈ B) = b → decide (l ∈ E) = b → decide (l ∈ U) = b) :
    ∀ a : ℕ, (incidenceInput A B).getD a false = b → (incidenceInput D E).getD a false = b →
      (incidenceInput T U).getD a false = b := by
  intro a
  if ha : a < 13 then
    let p : Fin 13 := ⟨a,ha⟩
    rw [readP A B p,readP D E p,readP T U p]
    exact hp p
  else if hb : a < 26 then
    let l : Fin 13 := ⟨a-13,by omega⟩
    have eq : a = 13+l.val := by dsimp [l];omega
    rw [eq,readL,readL,readL]
    exact hl l
  else simp only [readFar _ _ _ (by omega : 26 ≤ a)]; tauto
def posRow (i : Fin 52) := incidenceInput {(F i).1} {(F i).2}
def negRow (i : Fin 234) := incidenceInput (Q i) (missLines singerLines3 (Q i))
theorem positive_meet (i j : Fin 52) (lt : i < j) :
    ∃ k, ∀ a, (posRow i).getD a false = true → (posRow j).getD a false = true → (negRow k).getD a false = true := by
  have neq : F i ≠ F j := by intro h; have h' := f_strict lt; change 13*(F i).1.val+(F i).2.val < 13*(F j).1.val+(F j).2.val at h'; rw [h] at h'; omega
  by_cases e : (F i).1 = (F j).1
  · have el : (F i).2 ≠ (F j).2 := fun f => neq (Prod.ext e f)
    refine ⟨pointQ (F i).1,agree_rows _ _ _ _ _ _ _ ?_ ?_⟩
    · intro p h _
      have eqp : p = (F i).1 := Finset.mem_singleton.mp (of_decide_eq_true h)
      exact decide_eq_true (eqp.symm ▸ pointQ_ok (F i).1)
    · intro l h h'
      exact (el ((Finset.mem_singleton.mp (of_decide_eq_true h)).symm.trans (Finset.mem_singleton.mp (of_decide_eq_true h')))).elim
  · refine ⟨lineQ (F i).2,agree_rows _ _ _ _ _ _ _ ?_ ?_⟩
    · intro p h h'
      exact (e ((Finset.mem_singleton.mp (of_decide_eq_true h)).symm.trans (Finset.mem_singleton.mp (of_decide_eq_true h')))).elim
    · intro l h _
      have eql : l = (F i).2 := Finset.mem_singleton.mp (of_decide_eq_true h)
      exact decide_eq_true (eql.symm ▸ lineQ_ok (F i).2)
theorem negative_join (i j : Fin 234) (lt : i < j) :
    ∃ p l : Fin 13, p ∈ singerLines3 l ∧ ∀ a, (negRow i).getD a false = false →
      (negRow j).getD a false = false → (incidenceInput {p} {l}).getD a false = false := by
  have neq : Q i ≠ Q j := by intro h; have hk := q_strict lt; change key (Q i) < key (Q j) at hk; rw [h] at hk; omega
  have diff : ¬Q i ⊆ Q j := fun sub => neq (Finset.eq_of_subset_of_card_le sub (by rw [(point_ok i).1,(point_ok j).1]))
  obtain ⟨p,pi,pj⟩ := Finset.not_subset.mp diff
  obtain ⟨inc,miss⟩ := extends_point j p pj
  refine ⟨p,line j p,inc,agree_rows _ _ _ _ _ _ _ ?_ ?_⟩
  · simp; grind
  · simp; grind

theorem row_family : ∀ (C : Circuit), RightOnIncidentPairs singerLines3 C → (∀ Q, IsQuadrangle singerLines3 Q → C.eval (incidenceInput Q (missLines singerLines3 Q)) = false) → ∀ b : Bool,
      ∃ r : Fin (if b then 52 else 234) → List Bool, (∀ i, C.eval (r i) = b) ∧ (∀ i j, i < j → ∃ z : List Bool, (r i).length = (r j).length ∧ (r i).length = z.length ∧ (∀ a : ℕ, (r i).getD a false = b → (r j).getD a false = b → z.getD a false = b) ∧ C.eval z ≠ b) := by
  intro C pos neg b
  cases b with
  | false =>
    refine ⟨negRow,fun i => neg _ (point_ok i),?_⟩
    intro i j h
    obtain ⟨p,l,inc,ag⟩ := negative_join i j h
    exact ⟨_,by simp [negRow,incidenceInput],by simp [negRow,incidenceInput],ag,by simp [pos _ _ inc]⟩
  | true =>
    refine ⟨posRow,fun i => pos _ _ (flag_ok i),?_⟩
    intro i j h
    obtain ⟨k,ag⟩ := positive_meet i j h
    exact ⟨negRow k,by simp [posRow,incidenceInput],by simp [posRow,negRow,incidenceInput],ag,by simpa [negRow] using neg _ (point_ok k)⟩
