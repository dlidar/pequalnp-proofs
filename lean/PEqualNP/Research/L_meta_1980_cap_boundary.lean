private theorem checked : check (.split 0 t88 (.split 13 (.split 17 (.split 23 (.split 25 (.split 1 (.split 2 t105 (.split 8 (.split 12 (.split 15 (.split 19 (.split 14 t108 (.bad 8)) (.bad 10)) (.bad 9)) (.bad 55)) (.bad 54))) (.split 3 (.split 9 (.split 14 (.split 5 (.split 24 (.split 18 t111 (.bad 6)) (.bad 7)) t112) (.bad 5)) (.bad 53)) (.bad 52))) (.bad 3)) (.bad 2)) (.bad 1)) (.bad 0))) 0 (BitVec.allOnes 26) = true := by decide +kernel
theorem exact_boundary (x : Word) : Generic x ↔ ∃ y ∈ boundary, below x y = true := by
  constructor
  · intro gx
    exact tree_sound _ _ _ _ checked ((bits_iff _ _).mpr (by simp)) ((bits_iff _ _).mpr (fun i hi _ => by rw [BitVec.getLsbD_allOnes]; simp [hi])) gx
  · rintro ⟨y,hy,h⟩; exact downward h (boundary_checked _ hy)

theorem negative_tests (F : Word → Bool) (mono : ∀ x y, below x y = true → F x = true → F y = true) :
    (∀ x, Generic x → F x = false) ↔ ∀ y ∈ boundary, F y = false := by
  refine ⟨fun h y hy => h y (boundary_checked y hy),?_⟩
  intro h x gx
  obtain ⟨y,hy,xy⟩ := (exact_boundary x).mp gx
  cases fx : F x with
  | false => rfl
  | true => exact Bool.noConfusion ((mono x y xy fx).symm.trans (h y hy))

def active (x : Word) := univ.filter fun i : Fin 26 => x.getLsbD i.val

theorem sizes : ∀ x ∈ boundary, (active x).card = 7 ∧
    (((pts x).card = 4 ∧ (lines x).card = 3) ∨ ((pts x).card = 3 ∧ (lines x).card = 4)) := by
  have h : boundary.all (fun x => decide ((active x).card = 7 ∧
      (((pts x).card = 4 ∧ (lines x).card = 3) ∨ ((pts x).card = 3 ∧ (lines x).card = 4)))) = true := by decide +kernel
  exact fun x hx => of_decide_eq_true (List.all_eq_true.mp h x hx)
theorem distinct_samples : boundary.Nodup := by decide +kernel
theorem sample_count : boundary.length = 468 ∧ (boundary.filter (fun x => (pts x).card = 4)).length = 234 := by decide +kernel

theorem antichain {x y : Word} (hx : x ∈ boundary) (hy : y ∈ boundary) (xy : below x y) : x = y := by
  have sub : active x ⊆ active y := by
    intro i hi
    exact mem_filter.mpr ⟨mem_univ _,(bits_iff _ _).mp xy i i.isLt (mem_filter.mp hi).2⟩
  have eq : active x = active y := eq_of_subset_of_card_le sub (by rw [(sizes x hx).1,(sizes y hy).1])
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  have same := congrArg (fun S : Finset (Fin 26) => decide ((⟨i,hi⟩ : Fin 26) ∈ S)) eq
  change x[i] = y[i]
  simpa [active] using same

theorem encode (P L : Finset V) : ∃ x : Word, pts x = P ∧ lines x = L := by
  let v : Fin (13+13) → Bool := Fin.append (fun p => decide (p ∈ P)) (fun l => decide (l ∈ L))
  let x : Word := (BitVec.ofBoolListLE (List.ofFn v)).cast (by simp)
  have val (i : Fin 26) : x.getLsbD i.val = v i := by
    simp only [x,BitVec.getLsbD_cast,BitVec.getLsbD_ofBoolListLE]
    rw [List.getD_eq_getElem _ _ (by simp),List.getElem_ofFn]
  refine ⟨x,?_,?_⟩
  · ext p
    simp only [pts,mem_filter,mem_univ,true_and]
    rw [show x.getLsbD p.val = v (Fin.castAdd 13 p) from val (Fin.castAdd 13 p)]
    simp [v,Fin.append_left]
  · ext l
    simp only [lines,mem_filter,mem_univ,true_and]
    rw [show x.getLsbD (13+l.val) = v (Fin.natAdd 13 l) from val (Fin.natAdd 13 l)]
    simp only [v, Fin.append_right, decide_eq_true_eq]

theorem plane_tests (F : Finset V → Finset V → Bool) (mono : ∀ P L P' L', P ⊆ P' → L ⊆ L' → F P L = true → F P' L' = true) :
    (∀ P L, (∀ p ∈ P, ∀ l ∈ L, ¬inc p l) → (∀ l : V, (P.filter (fun p => inc p l)).card ≤ 2) →
      (∀ p : V, (L.filter (fun l => inc p l)).card ≤ 2) → F P L = false) ↔
    ∀ y ∈ boundary, F (pts y) (lines y) = false := by
  constructor
  · intro h y hy
    obtain ⟨a,b,c⟩ := boundary_checked _ hy
    exact h _ _ a b c
  · intro h P L a b c
    obtain ⟨x,rfl,rfl⟩ := encode P L
    exact (negative_tests (fun t => F (pts t) (lines t))
      (fun _ _ xy => mono _ _ _ _ (point_subset xy) (line_subset xy))).mpr h x ⟨a,b,c⟩

/-- Each negative test is indispensable among monotone functions, even with every positive test present. -/
def spoiler (w x : Word) : Bool :=
  decide (∃ p ∈ pts x, ∃ l ∈ lines x, inc p l) || below w x

theorem spoiler_mono (w x y : Word) (xy : below x y) (h : spoiler w x) : spoiler w y := by
  rcases Bool.or_eq_true_iff.mp h with hit|small
  · obtain ⟨p,hp,l,hl,e⟩ := of_decide_eq_true hit
    exact Bool.or_eq_true_iff.mpr (Or.inl (decide_eq_true ⟨p,point_subset xy hp,l,line_subset xy hl,e⟩))
  · exact Bool.or_eq_true_iff.mpr (Or.inr ((bits_iff _ _).mpr (fun j hj bit =>
      (bits_iff _ _).mp xy j hj ((bits_iff _ _).mp small j hj bit))))

theorem spoiler_positive (w x : Word) (p l : V) (hp : p ∈ pts x) (hl : l ∈ lines x) (e : inc p l) :
    spoiler w x = true :=
  Bool.or_eq_true_iff.mpr (Or.inl (decide_eq_true ⟨p,hp,l,hl,e⟩))

theorem spoiler_single_error {w x : Word} (wmem : w ∈ boundary) (xmem : x ∈ boundary) :
    spoiler w x = true ↔ w = x := by
  have absent : ¬∃ p ∈ pts x, ∃ l ∈ lines x, inc p l := by
    rintro ⟨p,hp,l,hl,e⟩
    exact (boundary_checked _ xmem).1 p hp l hl e
  simp only [spoiler,decide_eq_false absent,Bool.false_or]
  exact ⟨antichain wmem xmem, fun eq => (bits_iff _ _).mpr (by subst x; simp)⟩

