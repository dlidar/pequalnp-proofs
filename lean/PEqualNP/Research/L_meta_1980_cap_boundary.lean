import Mathlib.Tactic
import PEqualNP.Defs.TopForm

namespace PEqualNP.Research.CapBoundary
open Finset
abbrev V := Fin 13
abbrev Word := BitVec 26
def pts (x : Word) : Finset V := univ.filter fun i => x.getLsbD i.val
def lines (x : Word) : Finset V := univ.filter fun i => x.getLsbD (13+i.val)
def inc (p l : V) := p-l ∈ ({0,1,3,9} : Finset V)
instance (p l) : Decidable (inc p l) := by unfold inc; infer_instance
def Generic (x : Word) := (∀ p ∈ pts x, ∀ l ∈ lines x, ¬inc p l) ∧
  (∀ k : V, ((pts x).filter fun p => inc p k).card ≤ 2) ∧
  (∀ k : V, ((lines x).filter fun l => inc k l).card ≤ 2)
instance (x) : Decidable (Generic x) := by unfold Generic; infer_instance
def below (x y : Word) := (x &&& y) == x
theorem point_subset {x y} (h : below x y) : pts x ⊆ pts y := by
  intro i hi
  apply mem_filter.mpr
  refine ⟨mem_univ _,?_⟩
  have eq : x &&& y = x := eq_of_beq h
  have H := congrArg (fun z : Word => z.getLsbD i.val) eq
  simpa [(mem_filter.mp hi).2] using H
theorem line_subset {x y} (h : below x y) : lines x ⊆ lines y := by
  intro i hi
  apply mem_filter.mpr
  refine ⟨mem_univ _,?_⟩
  have eq : x &&& y = x := eq_of_beq h
  have H := congrArg (fun z : Word => z.getLsbD (13+i.val)) eq
  simpa [(mem_filter.mp hi).2] using H
theorem downward {x y} (h : below x y) (g : Generic y) : Generic x := by
  refine ⟨fun p hp l hl => g.1 p (point_subset h hp) l (line_subset h hl),?_,?_⟩
  · intro k; exact (card_le_card (filter_subset_filter _ (point_subset h))).trans (g.2.1 k)
  · intro k; exact (card_le_card (filter_subset_filter _ (line_subset h))).trans (g.2.2 k)
