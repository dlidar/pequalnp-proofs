theorem bits_iff (x y : Word) : below x y = true ↔ ∀ i < 26, x.getLsbD i = true → y.getLsbD i = true := by
  constructor
  · intro h i _ hx
    have eq : x &&& y = x := eq_of_beq h
    simpa [hx] using congrArg (fun z : Word => z.getLsbD i) eq
  · intro h
    apply beq_iff_eq.mpr
    apply BitVec.eq_of_getLsbD_eq
    intro i hi
    cases hx : x.getLsbD i
    · simp [hx]
    · simp [hx,h i hi hx]

private inductive Tree
  | bad (i : Nat)
  | good (i : Nat)
  | split (i : Nat) (off on : Tree)

private def check : Tree → Word → Word → Bool
  | .bad i, lo, _ => if h : i < forbidden.length then below forbidden[i] lo else false
  | .good i, _, hi => if h : i < boundary.length then below hi boundary[i] else false
  | .split i off on, lo, hi =>
    check off lo (hi &&& ~~~(BitVec.twoPow 26 i)) && check on (lo ||| BitVec.twoPow 26 i) hi

private theorem tree_sound (t : Tree) (lo hi x : Word) (ok : check t lo hi = true)
    (lower : below lo x) (upper : below x hi) (gx : Generic x) : ∃ y ∈ boundary, below x y = true := by
  have trans {a b c : Word} (ab : below a b) (bc : below b c) : below a c :=
    (bits_iff _ _).mpr fun i h hi => (bits_iff _ _).mp bc i h ((bits_iff _ _).mp ab i h hi)
  induction t generalizing lo hi with
  | bad i =>
    simp only [check] at ok
    split at ok
    · rename_i h
      exact (forbidden_checked _ (List.getElem_mem h) (downward (trans ok lower) gx)).elim
    · exact Bool.noConfusion ok
  | good i =>
    simp only [check] at ok
    split at ok
    · rename_i h
      exact ⟨_,List.getElem_mem h,trans upper ok⟩
    · exact Bool.noConfusion ok
  | split i off on left right =>
    obtain ⟨offok,onok⟩ := Bool.and_eq_true_iff.mp ok
    cases hx : x.getLsbD i
    · apply left _ _ offok lower
      apply (bits_iff _ _).mpr
      intro j hj v
      have ne : i ≠ j := by rintro rfl; simp [hx] at v
      simp [hj,Ne.symm ne,(bits_iff _ _).mp upper j hj v]
    · apply right _ _ onok _ upper
      apply (bits_iff _ _).mpr
      intro j hj v
      simp only [BitVec.getLsbD_or,BitVec.getLsbD_twoPow,Bool.or_eq_true_iff,Bool.and_eq_true_iff,decide_eq_true_eq] at v
      rcases v with w|⟨_,rfl⟩
      · exact (bits_iff _ _).mp lower j hj w
      · exact hx

